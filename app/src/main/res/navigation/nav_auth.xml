<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_auth"
    app:startDestination="@id/auth_login">

    <fragment
        android:id="@+id/auth_login"
        android:name="com.aula.volta.ui.auth.LoginFragment"
        tools:layout="@layout/fragment_login" />

    <fragment
        android:id="@+id/auth_register"
        android:name="com.aula.volta.ui.auth.RegisterFragment"
        tools:layout="@layout/fragment_register" />

    <fragment
        android:id="@+id/auth_confirm"
        android:name="com.aula.volta.ui.auth.ConfirmEmailFragment"
        tools:layout="@layout/fragment_confirm_email">
        <argument
            android:name="email"
            app:argType="string" />
        <argument
            android:name="name"
            app:argType="string" />
        <argument
            android:name="sector"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="password"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/auth_success"
        android:name="com.aula.volta.ui.auth.SuccessFragment"
        tools:layout="@layout/fragment_auth_success">
        <argument
            android:name="email"
            app:argType="string" />
        <argument
            android:name="name"
            app:argType="string" />
        <argument
            android:name="sector"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="password"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/auth_forgot"
        android:name="com.aula.volta.ui.auth.ForgotPasswordFragment"
        tools:layout="@layout/fragment_forgot_password" />

    <fragment
        android:id="@+id/auth_passcode"
        android:name="com.aula.volta.ui.auth.PasswordCodeFragment"
        tools:layout="@layout/fragment_password_code">
        <argument
            android:name="email"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/auth_reset"
        android:name="com.aula.volta.ui.auth.ResetPasswordFragment"
        tools:layout="@layout/fragment_reset_password">
        <argument
            android:name="email"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="code"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/auth_passok"
        android:name="com.aula.volta.ui.auth.PasswordSuccessFragment"
        tools:layout="@layout/fragment_password_success" />

    <fragment
        android:id="@+id/auth_offline_error"
        android:name="com.aula.volta.ui.error.OfflineErrorFragment"
        tools:layout="@layout/fragment_offline_error">
        <argument
            android:name="title"
            android:defaultValue="Sem conexão por aqui"
            app:argType="string" />
        <argument
            android:name="message"
            android:defaultValue="Você precisa de uma conexão com a internet para entrar no VOLTA."
            app:argType="string" />
        <argument
            android:name="badge"
            android:defaultValue="Você está offline"
            app:argType="string" />
        <argument
            android:name="errorType"
            android:defaultValue="OFFLINE"
            app:argType="string" />
    </fragment>

</navigation>
