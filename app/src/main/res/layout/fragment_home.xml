<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volta_background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_normal"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_normal"
        android:paddingBottom="@dimen/spacing_large">

        <!-- =================================================================================== -->
        <!--                            HEADER: Avatar + Saudação + Notificação                  -->
        <!-- =================================================================================== -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium">

            <!-- Avatar circular com iniciais -->
            <FrameLayout
                android:id="@+id/avatarContainer"
                android:layout_width="@dimen/avatar_size_home"
                android:layout_height="@dimen/avatar_size_home"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_avatar">

                <TextView
                    android:id="@+id/tvAvatarInitials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="BG"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Saudação e nome do usuário -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_toEndOf="@id/avatarContainer"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/greeting_morning"
                    android:textColor="@color/volta_text_secondary_light"
                    android:textSize="@dimen/text_size_body_small" />

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Breno Gomes"
                    android:textColor="@color/volta_text_primary_light"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Botão de notificação: círculo branco + sino + dot vermelho -->
            <FrameLayout
                android:id="@+id/btnNotifications"
                android:layout_width="@dimen/tap_target_min"
                android:layout_height="@dimen/tap_target_min"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:contentDescription="Notificações"
                android:focusable="true">

                <!-- Círculo branco com borda sutil -->
                <View
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_notification_circle"
                    android:elevation="2dp" />

                <!-- Ícone do sino (stroke) -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:elevation="3dp"
                    android:src="@drawable/ic_notification_bell" />

                <!-- Badge contador (Figma Home nova: círculo vermelho com número) -->
                <TextView
                    android:id="@+id/tvNotifCount"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge_count"
                    android:elevation="4dp"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
        </RelativeLayout>

        <!-- =================================================================================== -->
        <!--                   CARROSSEL HOME (Figma 790:1624: CTA + Últimos 7 dias)            -->
        <!-- =================================================================================== -->

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpCarousel"
            android:layout_width="match_parent"
            android:layout_height="200dp" />

        <LinearLayout
            android:id="@+id/carouselDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:gravity="center"
            android:orientation="horizontal" />

        <!-- =================================================================================== -->
        <!--                            RESUMO DA UNIDADE — Título                               -->
        <!-- =================================================================================== -->

        <!-- Loading da Home (Fase 2: some quando resumo + recentes + dot carregam) -->
        <ProgressBar
            android:id="@+id/loadingHome"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/spacing_medium" />

        <!-- =================================================================================== -->
        <!--                            BIG NUMBERS — 3 Cards de Estatísticas                    -->
        <!-- =================================================================================== -->

        <TextView
            android:layout_width="163dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:text="@string/home_summary_title"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Card 1: Abertas (laranja) - bg #FFEFE2 conforme Assets OcorrenciasAbertas/Rectangle.svg -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:layout_weight="1"
                android:background="@drawable/bg_card_stat_open"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <!-- Ícone + dentro de círculo laranja -->
                <FrameLayout
                    android:layout_width="@dimen/icon_size_stat"
                    android:layout_height="@dimen/icon_size_stat"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:background="@drawable/bg_stat_icon_orange">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_stat_open" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStatOpenCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9"
                    android:textColor="@color/stat_open_icon"
                    android:textSize="@dimen/text_size_headline"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_stat_open"
                    android:textColor="@color/volta_text_secondary_light"
                    android:textSize="@dimen/text_size_caption" />
            </LinearLayout>

            <!-- Card 2: Resolvidas (verde) - bg #E2F7EC conforme Assets OcorrenciasResolvidas/Rectangle.svg -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:layout_weight="1"
                android:background="@drawable/bg_card_stat_resolved"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <!-- Ícone check dentro de círculo verde -->
                <FrameLayout
                    android:layout_width="@dimen/icon_size_stat"
                    android:layout_height="@dimen/icon_size_stat"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:background="@drawable/bg_stat_icon_green">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_stat_resolved" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStatResolvedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="43"
                    android:textColor="@color/stat_resolved_icon"
                    android:textSize="@dimen/text_size_headline"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_stat_resolved"
                    android:textColor="@color/volta_text_secondary_light"
                    android:textSize="@dimen/text_size_caption" />
            </LinearLayout>

            <!-- Card 3: kg Reciclados (azul) - bg #E4EFFF conforme Assets KgReciclados/Rectangle.svg -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_weight="1"
                android:background="@drawable/bg_card_stat_recycled"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <!-- Ícone seta circular dentro de círculo azul -->
                <FrameLayout
                    android:layout_width="@dimen/icon_size_stat"
                    android:layout_height="@dimen/icon_size_stat"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:background="@drawable/bg_stat_icon_blue">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_stat_recycled" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStatRecycledCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.147"
                    android:textColor="@color/stat_recycled_icon"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_stat_recycled"
                    android:textColor="@color/volta_text_secondary_light"
                    android:textSize="@dimen/text_size_caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- =================================================================================== -->
        <!--                            OCORRÊNCIAS RECENTES — Título + Ver todas                -->
        <!-- =================================================================================== -->

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_small">

            <TextView
                android:layout_width="192dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginStart="0dp"
                android:text="@string/home_recent_occurrences"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="@dimen/text_size_subtitle"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSeeAllOccurrences"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="6dp"
                android:text="@string/home_see_all"
                android:textColor="@color/volta_green_dark"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- =================================================================================== -->
        <!--              OCORRÊNCIAS RECENTES — lista dinâmica (Fase 2, mesmo visual Figma)     -->
        <!-- =================================================================================== -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentOccurrences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_small"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/tvEmptyOccurrences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/spacing_large"
            android:text="@string/empty_list"
            android:textColor="@color/volta_text_secondary_light"
            android:textSize="@dimen/text_size_body_small"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
