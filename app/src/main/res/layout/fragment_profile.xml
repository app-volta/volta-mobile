<?xml version="1.0" encoding="utf-8"?>
<!-- Perfil — Figma 790:3470: header, sobre você, configurações, sair -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volta_background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_normal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:text="@string/nav_profile"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:background="@drawable/bg_card_cta"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_normal">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_avatar">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="BG"
                    android:textColor="@color/volta_green_dark"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_name"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_section"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_role"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_body_small" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_unit"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_body_small" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sobre você -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_small">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/profile_about"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="@dimen/text_size_section"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnEditProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/spacing_small"
                android:text="@string/profile_edit"
                android:textColor="@color/volta_green_primary"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_small"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_small"
                android:layout_weight="1"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_occurrence_icon">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_notif_bell"
                            app:tint="@color/occurrence_icon_tint" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:text="@string/profile_email"
                        android:textColor="@color/volta_text_secondary_light"
                        android:textSize="@dimen/text_size_body_small" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_email_value"
                    android:textColor="@color/volta_text_primary_light"
                    android:textSize="@dimen/text_size_body_small"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_occurrence_icon_purple">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_notif_star"
                            app:tint="@color/occurrence_icon_tint_purple" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:text="@string/profile_since"
                        android:textColor="@color/volta_text_secondary_light"
                        android:textSize="@dimen/text_size_body_small" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_since_value"
                    android:textColor="@color/volta_text_primary_light"
                    android:textSize="@dimen/text_size_body_small"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_small"
                android:layout_weight="1"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_stat_icon_orange">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_stat_open"
                            app:tint="@color/stat_open_icon" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:text="@string/profile_occ"
                        android:textColor="@color/volta_text_secondary_light"
                        android:textSize="@dimen/text_size_body_small" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvProfileOccurrences"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/volta_text_primary_light"
                    android:textSize="@dimen/text_size_body_small"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_stat_icon_green">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_stat_resolved"
                            app:tint="@color/stat_resolved_icon" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:text="@string/profile_recovered"
                        android:textColor="@color/volta_text_secondary_light"
                        android:textSize="@dimen/text_size_body_small" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvProfileRecovered"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/volta_text_primary_light"
                    android:textSize="@dimen/text_size_body_small"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Configurações -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_small"
            android:text="@string/profile_settings"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="@dimen/text_size_section"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/rowProfileNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_small"
            android:background="@drawable/bg_card_surface"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_medium">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_notif_bell"
                app:tint="@color/volta_text_secondary_light" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_weight="1"
                android:text="@string/profile_notifications"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="@dimen/text_size_body" />

            <TextView
                android:id="@+id/tvProfileNotifCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_small"
                android:textColor="@color/volta_text_secondary_light"
                android:textSize="@dimen/text_size_body_small" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:rotation="180"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/volta_text_muted_light" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowProfileUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_small"
            android:background="@drawable/bg_card_surface"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_medium">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_pin"
                app:tint="@color/volta_text_secondary_light" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_weight="1"
                android:text="@string/profile_my_unit"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="@dimen/text_size_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_small"
                android:text="@string/profile_my_unit_value"
                android:textColor="@color/volta_text_secondary_light"
                android:textSize="@dimen/text_size_body_small" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:rotation="180"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/volta_text_muted_light" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowProfileHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:background="@drawable/bg_card_surface"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_medium">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/volta_text_secondary_light" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_weight="1"
                android:text="@string/profile_help"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="@dimen/text_size_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_small"
                android:text="@string/profile_help_hint"
                android:textColor="@color/volta_text_secondary_light"
                android:textSize="@dimen/text_size_body_small" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:rotation="180"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/volta_text_muted_light" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_primary"
            android:layout_marginBottom="@dimen/spacing_large"
            android:text="@string/profile_logout"
            android:textColor="@color/priority_high_text"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            app:cornerRadius="@dimen/corner_radius_button"
            app:strokeColor="@color/priority_high_text" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
