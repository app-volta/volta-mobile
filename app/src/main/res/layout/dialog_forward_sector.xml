<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo para Encaminhar Ocorrência para Outro Setor (Figma 790:2725 / Fase 33) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_finalize"
    android:elevation="12dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_action_chip">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@string/occ_action_forward"
            android:src="@drawable/ic_forward"
            app:tint="@color/occurrence_icon_tint_blue" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="@string/occ_action_forward"
        android:textColor="@color/dialog_finalize_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="Selecione a área operacional para onde o resíduo deve ser transferido:"
        android:textColor="@color/dialog_finalize_sub"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rgSectors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/rbSectorFrigorifico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Frigorífico B2"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbSectorExpedicao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Expedição Central"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbSectorDesossa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Desossa Suína"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbSectorMaquinas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Sala de Máquinas"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbSectorManutencao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Manutenção Fabril"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="14sp" />
    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmForward"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="@color/volta_green_primary"
        android:text="Confirmar transferência"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />

    <TextView
        android:id="@+id/btnCancelForward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:text="@string/pick_confirm_no"
        android:textColor="@color/dialog_finalize_sub"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
