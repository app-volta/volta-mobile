<?xml version="1.0" encoding="utf-8"?>
<!-- Aba Coops: SÓ cooperativas (nunca ocorrências). Figma Cooperativas (626:582, sem mapa — Maps key pendente).
     Versão contextual por ocorrência chega na Fase 8 (feat/cooperatives). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volta_background_light"
    android:orientation="vertical"
    android:padding="@dimen/spacing_normal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/coops_title"
        android:textColor="@color/volta_text_primary_light"
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:text="@string/coops_subtitle"
        android:textColor="@color/volta_text_secondary_light"
        android:textSize="@dimen/text_size_body_small" />

    <ProgressBar
        android:id="@+id/loadingCooperatives"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_large" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCooperatives"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/tvEmptyCooperatives"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/spacing_large"
        android:text="@string/empty_list"
        android:textColor="@color/volta_text_secondary_light"
        android:textSize="@dimen/text_size_body_small"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTalkTo"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_primary"
        android:layout_marginTop="@dimen/spacing_medium"
        android:backgroundTint="@color/volta_green_primary"
        android:text="@string/chat_talk_generic"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold"
        app:cornerRadius="@dimen/corner_radius_button" />
</LinearLayout>
