<?xml version="1.0" encoding="utf-8"?>
<!-- Aba Coops: Cooperativas próximas com Mapa vetorial oficial e painel deslizante (Figma 790:3111) -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volta_background_light">

    <!-- 1. Mapa oficial com pinos das cooperativas no topo (Figma 790:3112) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp">

        <ImageView
            android:id="@+id/imgCoopsMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Mapa de cooperativas próximas"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_coops_map" />

        <!-- Botão voltar opcional (ativo se tela aberta via subfluxo) -->
        <FrameLayout
            android:id="@+id/btnBackCoops"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="16dp"
            android:background="@drawable/bg_notification_circle"
            android:clickable="true"
            android:contentDescription="@string/occurrence_back"
            android:elevation="4dp"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_left" />
        </FrameLayout>
    </FrameLayout>

    <!-- 2. Painel arredondado de cooperativas (Figma 790:3135) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="190dp"
        android:background="@drawable/bg_panel_cooperatives"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_normal"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/spacing_normal"
        android:paddingBottom="16dp">

        <!-- Alça superior (Figma 790:3139) -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_panel_handle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/coops_title"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="@dimen/spacing_small"
            android:text="@string/coops_subtitle"
            android:textColor="@color/volta_text_secondary_light"
            android:textSize="@dimen/text_size_body_small" />

        <ProgressBar
            android:id="@+id/loadingCooperatives"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_medium" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCooperatives"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tvEmptyCooperatives"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/spacing_large"
            android:text="@string/empty_list"
            android:textColor="@color/volta_text_secondary_light"
            android:textSize="@dimen/text_size_body_small"
            android:visibility="gone" />

        <!-- Botão fixo no rodapé: Conversar com JBS Ambiental (Figma 790:3185) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTalkTo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/spacing_small"
            android:backgroundTint="@color/volta_green_primary"
            android:text="@string/chat_talk_generic"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            app:cornerRadius="@dimen/corner_radius_button" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
