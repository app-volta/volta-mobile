<?xml version="1.0" encoding="utf-8"?>
<!-- Slide 1 do carrossel Home (Figma 790:1649): CTA com mascote, setas em marca d'água e botão Registrar agora -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="4dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="14dp"
    android:outlineAmbientShadowColor="#0E7C48"
    android:outlineSpotShadowColor="#0E7C48"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_cta"
        android:clipChildren="true"
        android:clipToPadding="true">

        <!-- Seta decorativa superior direita (Figma 790:1650) -->
        <ImageView
            android:layout_width="119dp"
            android:layout_height="119dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-18dp"
            android:layout_marginEnd="-15dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_cta_arrow_loop" />

        <!-- Seta decorativa inferior esquerda (Figma 790:1653) -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="-10dp"
            android:layout_marginBottom="-15dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_cta_arrow_curve" />

        <!-- Brilho suave atrás do mascote (Figma 790:1656) -->
        <View
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="-16dp"
            android:background="@drawable/bg_cta_glow" />

        <!-- Coluna esquerda: Título + Subtítulo + Botão branco 152x40dp (Figma 790:1657..1659) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="118dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_poppins"
                android:includeFontPadding="false"
                android:lineSpacingExtra="-4dp"
                android:text="@string/home_cta_title"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/font_inter"
                android:lineSpacingExtra="2dp"
                android:text="@string/home_cta_subtitle"
                android:textColor="#EBFFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/btnSlideRegister"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_cta_button_white"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="152dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_camera_official"
                    app:tint="#0E7C48" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/font_poppins"
                    android:includeFontPadding="false"
                    android:text="@string/home_cta_button"
                    android:textColor="#0E7C48"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mascote VOLTA (Figma 790:1663: 113x140dp) -->
        <ImageView
            android:id="@+id/ctaMascot"
            android:layout_width="113dp"
            android:layout_height="140dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="14dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/mascote_volta" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
