<?xml version="1.0" encoding="utf-8"?>
<!-- Card de ocorrência recente (Figma 790:1706: 74dp, corner 20dp, borda 1dp #EEF0F5, chip 46x46dp r=14dp) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="74dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_surface"
    android:elevation="1dp"
    android:outlineAmbientShadowColor="#1F0D261A"
    android:outlineSpotShadowColor="#1F0D261A"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:id="@+id/cardIconContainer"
        android:layout_width="@dimen/thumbnail_size_occurrence"
        android:layout_height="@dimen/thumbnail_size_occurrence"
        android:background="@drawable/bg_occurrence_icon">

        <ImageView
            android:id="@+id/cardThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/cardIcon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_occurrence_waste" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/font_inter"
            android:maxLines="1"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cardSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="@font/font_inter"
            android:maxLines="1"
            android:textColor="@color/volta_text_secondary_light"
            android:textSize="12.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/cardBadge"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:background="@drawable/bg_badge_media"
        android:fontFamily="@font/font_inter"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textAllCaps="true"
        android:textColor="@color/priority_medium_text"
        android:textSize="10.5sp"
        android:textStyle="bold" />
</LinearLayout>
