<?xml version="1.0" encoding="utf-8"?>
<!-- Login — Figma Oficial 790:955 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_login_official"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <!-- Logo VOLTA Superior (Figma 790:967 - 116x34) -->
        <ImageView
            android:id="@+id/ivLoginTopLogo"
            android:layout_width="116dp"
            android:layout_height="34dp"
            android:layout_marginBottom="32dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitStart"
            android:src="@drawable/logo_volta_white" />

        <!-- Título com Logo integrada (Figma 790:969, 790:970, 790:971) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_poppins"
                android:text="Bem-vindo de"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="85dp"
                android:layout_height="25dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_volta_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_poppins"
                android:text="!"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subtítulo Oficial (Figma 790:972 - Inter 400 13.5sp, 85% opacidade) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            android:fontFamily="@font/font_inter"
            android:lineSpacingExtra="3dp"
            android:text="@string/auth_welcome_sub"
            android:textColor="@color/login_subtitle_white"
            android:textSize="13.5sp" />

        <!-- Label E-mail (Figma 790:973 - Poppins SemiBold 14sp) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/font_poppins"
            android:text="@string/auth_email"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Input E-mail Translúcido com Ícone (Figma 790:974) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_input_auth_translucent">

            <EditText
                android:id="@+id/etLoginEmail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fontFamily="@font/font_inter"
                android:hint="breno@empresa.com.br"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress"
                android:paddingStart="18dp"
                android:paddingEnd="48dp"
                android:text="breno@volta.com"
                android:textColor="@color/white"
                android:textColorHint="@color/login_hint_white"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_mail"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- Label Senha (Figma 790:979 - Poppins SemiBold 14sp) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/font_poppins"
            android:text="@string/auth_password"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Input Senha Translúcido com Ícone Toggle (Figma 790:980) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_auth_translucent">

            <EditText
                android:id="@+id/etLoginPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fontFamily="@font/font_inter"
                android:hint="••••••••"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:paddingStart="18dp"
                android:paddingEnd="48dp"
                android:text="1234"
                android:textColor="@color/white"
                android:textColorHint="@color/login_hint_white"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btnTogglePassword"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true"
                android:src="@drawable/ic_eye"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- Link Esqueci minha senha (Figma 790:985 - Inter SemiBold 12.5sp) -->
        <TextView
            android:id="@+id/btnForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/font_inter"
            android:paddingVertical="4dp"
            android:text="@string/auth_forgot"
            android:textColor="@color/white"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <!-- Botão Entrar Oficial Figma (790:986 - Branco Puro, r16, Texto Verde Escuro #1BA463) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_button_auth_white"
            android:fontFamily="@font/font_poppins"
            android:stateListAnimator="@null"
            android:text="@string/auth_login_btn"
            android:textAllCaps="false"
            android:textColor="@color/login_btn_text_green"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Divisor "ou" (Figma 790:988, 790:989, 790:990) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#80FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:fontFamily="@font/font_inter"
                android:text="@string/auth_or"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#80FFFFFF" />
        </LinearLayout>

        <!-- Botão Continuar com Google Oficial Figma (790:991 - Fundo Translúcido 6%, borda 75%, r16) -->
        <LinearLayout
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_button_auth_google"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_google_circle">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_google_logo" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_inter"
                android:text="@string/auth_google"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Atalho Rápido para Demonstração (Facilitador de Teste/QA) -->
        <LinearLayout
            android:id="@+id/btnDemoLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_pill_dark"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/sparkle_light" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_poppins"
                    android:text="Acesso Rápido de Teste"
                    android:textColor="@color/sparkle_light"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_inter"
                    android:text="Toque para preencher breno@volta.com"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Rodapé de Cadastro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_inter"
                android:text="@string/auth_no_account"
                android:textColor="@color/login_subtitle_white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnGoRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/font_poppins"
                android:padding="4dp"
                android:text="@string/auth_create"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
