<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_chatbot"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/mascote_volta" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_poppins"
                android:text="Chatbot VOLTA (QA)"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_inter"
                android:text="Insira as credenciais do ambiente QA"
                android:textColor="@color/volta_text_secondary_light"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#E5E7EB" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/font_poppins"
        android:text="E-mail QA"
        android:textColor="@color/volta_text_primary_light"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etChatbotQaEmail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_card_surface"
        android:fontFamily="@font/font_inter"
        android:hint="email@qa.volta.com"
        android:importantForAutofill="no"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="14dp"
        android:textColor="@color/volta_text_primary_light"
        android:textColorHint="@color/volta_text_muted_light"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/font_poppins"
        android:text="Senha QA"
        android:textColor="@color/volta_text_primary_light"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etChatbotQaPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_card_surface"
        android:fontFamily="@font/font_inter"
        android:hint="••••••••"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:textColor="@color/volta_text_primary_light"
        android:textColorHint="@color/volta_text_muted_light"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelChatbotLogin"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/font_poppins"
            android:gravity="center"
            android:text="Cancelar"
            android:textColor="@color/volta_text_secondary_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnConfirmChatbotLogin"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.4"
            android:background="@drawable/bg_button_gradient"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/font_poppins"
            android:gravity="center"
            android:text="Autenticar QA"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
