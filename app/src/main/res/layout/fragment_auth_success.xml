<?xml version="1.0" encoding="utf-8"?>
<!-- Sucesso — conta criada (Fase 13) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volta_background_light"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_large">

    <FrameLayout
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:background="@drawable/bg_occurrence_icon_green">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_notif_check"
            app:tint="@color/stat_resolved_icon" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auth_success_title"
        android:textColor="@color/volta_text_primary_light"
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:layout_marginBottom="@dimen/spacing_large"
        android:gravity="center"
        android:text="@string/auth_success_sub"
        android:textColor="@color/volta_text_secondary_light"
        android:textSize="@dimen/text_size_body_small" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_primary"
        android:backgroundTint="@color/volta_green_primary"
        android:text="@string/auth_start"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_body"
        android:textStyle="bold" />
</LinearLayout>
