<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo · Sair da conta (Figma 1721:1709) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_logout_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Chip Ícone Logout (64x64dp, pastel red #FDEAEC) -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_circle_logout_pastel">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_logout" />
    </FrameLayout>

    <!-- Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="Sair da conta?"
        android:textColor="#1B2430"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Mensagem -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/font_inter"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="Pra voltar, é só entrar de novo com seu e-mail e senha."
        android:textColor="#7C8698"
        android:textSize="14sp" />

    <!-- Botão Sim, sair -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmLogout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_button_logout"
        android:fontFamily="@font/font_inter"
        android:text="Sim, sair"
        android:textAllCaps="false"
        android:textColor="#E8556C"
        android:textSize="14.5sp"
        android:textStyle="bold" />

    <!-- Link Voltar / Cancelar -->
    <TextView
        android:id="@+id/btnCancelLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/font_inter"
        android:gravity="center"
        android:padding="8dp"
        android:text="Cancelar"
        android:textColor="#7C8698"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
