<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo para Alterar Classificação da Ocorrência (Figma 790:2725 / Fase 33) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_finalize"
    android:elevation="12dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_action_chip">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@string/occ_action_edit_class"
            android:src="@drawable/ic_stat_open"
            app:tint="@color/occurrence_icon_tint" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="@string/occ_action_edit_class"
        android:textColor="@color/dialog_finalize_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="Corrija a tipologia do resíduo para destinação e cálculo de indicadores PGRS:"
        android:textColor="@color/dialog_finalize_sub"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rgMaterials"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/rbMatPapelao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Papelão Ondulado (Classe II A)"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbMatPlastico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Plástico Filme / PEBD (Classe II B)"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbMatMetal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Metal / Sucata de Aço (Classe II B)"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbMatVidro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Vidro Transparente (Classe II B)"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbMatOrganico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Resíduo Orgânico / Graxaria (Classe II A)"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="14sp" />
    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmEditClass"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="@color/volta_green_primary"
        android:text="Salvar classificação"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />

    <TextView
        android:id="@+id/btnCancelEditClass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:text="@string/pick_confirm_no"
        android:textColor="@color/dialog_finalize_sub"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
