<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volta_background_light"
    android:fitsSystemWindows="true">

    <ImageButton
        android:id="@+id/btnErrorBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_round_white_btn"
        android:contentDescription="Voltar"
        android:elevation="2dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chevron_left"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewError"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/layoutErrorActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnErrorBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/ivErrorMascot"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/img_mascot_offline" />

            <TextView
                android:id="@+id/tvErrorBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_badge_offline"
                android:fontFamily="@font/font_inter"
                android:letterSpacing="0.04"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:text="Você está offline"
                android:textColor="#8A5F00"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvErrorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/font_poppins"
                android:gravity="center"
                android:text="Sem conexão por aqui"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/font_inter"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Verifique sua conexão com a internet para continuar utilizando o VOLTA."
                android:textColor="@color/volta_text_secondary_light"
                android:textSize="13.5sp" />

            <LinearLayout
                android:id="@+id/cardErrorInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_info_card_offline"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivErrorInfoIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info_circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvErrorInfoTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_inter"
                        android:text="Acesso à rede obrigatório"
                        android:textColor="#1D5FC4"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvErrorInfoBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/font_inter"
                        android:lineSpacingExtra="2dp"
                        android:text="O envio de ocorrências e o login exigem internet ativa para validação e sincronização com o sistema."
                        android:textColor="@color/volta_text_primary_light"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layoutErrorActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnErrorRetry"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/volta_green_primary"
            android:fontFamily="@font/font_poppins"
            android:text="Tentar de novo"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:elevation="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnErrorSecondary"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/font_poppins"
            android:text="Voltar"
            android:textAllCaps="false"
            android:textColor="@color/volta_green_dark"
            android:textSize="14.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
