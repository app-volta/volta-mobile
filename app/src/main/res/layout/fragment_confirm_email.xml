<?xml version="1.0" encoding="utf-8"?>
<!-- Confirmar e-mail — Figma 790:1055 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volta_background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- Botão Voltar (Figma 40x40dp, r20) -->
        <FrameLayout
            android:id="@+id/btnBackConfirm"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_notification_circle"
            android:clickable="true"
            android:contentDescription="@string/occurrence_back"
            android:elevation="2dp"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/volta_text_primary_light" />
        </FrameLayout>

        <!-- Badge Circular Padronizado 84x84dp (#FFEFE2 com dot vermelho #E8556C) -->
        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_circle_badge_pastel"
            android:backgroundTint="@color/priority_medium_bg">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/auth_confirm_title"
                    android:src="@drawable/ic_mail"
                    app:tint="@color/priority_medium_text" />

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge_red_dot" />
            </FrameLayout>
        </FrameLayout>

        <!-- Título e Subtítulo Alinhados ao Início (Start com margem de 28dp) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_poppins"
            android:text="@string/auth_confirm_title"
            android:textAlignment="viewStart"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConfirmSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/font_inter"
            android:text="@string/auth_confirm_sub"
            android:textAlignment="viewStart"
            android:textColor="@color/volta_text_secondary_light"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvConfirmEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="28dp"
            android:fontFamily="@font/font_inter"
            android:textAlignment="viewStart"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 4 caixas de código (68x72dp, r16, 16dp gap) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="28dp"
            android:gravity="start"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etCode1"
                android:layout_width="68dp"
                android:layout_height="72dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_code_box"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="24sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCode2"
                android:layout_width="68dp"
                android:layout_height="72dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_code_box"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="24sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCode3"
                android:layout_width="68dp"
                android:layout_height="72dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_code_box"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="24sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCode4"
                android:layout_width="68dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_code_box"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CTA Confirmar -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmCode"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_button_gradient"
            android:fontFamily="@font/font_poppins"
            android:stateListAnimator="@null"
            android:text="@string/auth_confirm_btn"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Reenvio de Código -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_inter"
                android:text="@string/auth_no_code"
                android:textColor="@color/volta_text_secondary_light"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvResendConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/font_inter"
                android:paddingVertical="6dp"
                android:textColor="@color/login_btn_text_green"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
