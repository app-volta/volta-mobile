<?xml version="1.0" encoding="utf-8"?>
<!-- Confirmar e-mail — 4 caixas com avanço automático (Fase 13, mock: aceita qualquer código) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volta_background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:background="@drawable/bg_occurrence_icon_green">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✉"
                android:textColor="@color/stat_resolved_icon"
                android:textSize="@dimen/text_size_headline" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_confirm_title"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConfirmSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginBottom="@dimen/spacing_large"
            android:gravity="center"
            android:textColor="@color/volta_text_secondary_light"
            android:textSize="@dimen/text_size_body_small" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etCode1"
                android:layout_width="56dp"
                android:layout_height="64dp"
                android:layout_marginEnd="@dimen/spacing_small"
                android:background="@drawable/bg_card_surface"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCode2"
                android:layout_width="56dp"
                android:layout_height="64dp"
                android:layout_marginEnd="@dimen/spacing_small"
                android:background="@drawable/bg_card_surface"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCode3"
                android:layout_width="56dp"
                android:layout_height="64dp"
                android:layout_marginEnd="@dimen/spacing_small"
                android:background="@drawable/bg_card_surface"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCode4"
                android:layout_width="56dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_card_surface"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmCode"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_primary"
            android:backgroundTint="@color/volta_green_primary"
            android:text="@string/auth_confirm_btn"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
