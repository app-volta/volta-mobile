<?xml version="1.0" encoding="utf-8"?>
<!-- Skeleton de card de ocorrência (espelha item_occurrence_card.xml) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="74dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <View
        android:layout_width="@dimen/thumbnail_size_occurrence"
        android:layout_height="@dimen/thumbnail_size_occurrence"
        android:background="@drawable/bg_skeleton_bar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <View
            android:layout_width="128dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_skeleton_bar" />

        <View
            android:layout_width="86dp"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_skeleton_bar" />
    </LinearLayout>

    <View
        android:layout_width="52dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_skeleton_pill" />
</LinearLayout>
