<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo para Confirmação de Destinação e Solicitação de Coleta (Figma 851:4068, 790:2820 / Fase 34) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_finalize"
    android:elevation="12dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="32dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_dialog_truck_circle">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:contentDescription="@string/pick_confirm_title"
            android:src="@drawable/ic_notif_truck"
            app:tint="@color/stat_recycled_icon" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvConfirmDestTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:text="@string/pick_confirm_title"
        android:textColor="@color/dialog_finalize_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvConfirmDestMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/pick_confirm_msg"
        android:textColor="@color/dialog_finalize_sub"
        android:textSize="14sp" />

    <!-- Card de resumo contextual da coleta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_search_input"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvConfirmDestCoopName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConfirmDestDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/volta_text_secondary_light"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmDestYes"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="@color/volta_green_primary"
        android:text="@string/pick_confirm_yes"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />

    <TextView
        android:id="@+id/btnConfirmDestNo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:text="@string/pick_confirm_no"
        android:textColor="@color/dialog_finalize_sub"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
