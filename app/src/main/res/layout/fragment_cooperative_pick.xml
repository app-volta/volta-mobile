<?xml version="1.0" encoding="utf-8"?>
<!-- Destinação contextual (Fase 8): cooperativas da ocorrência, backend ordena -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volta_background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_normal">

        <FrameLayout
            android:id="@+id/btnBackPick"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:background="@drawable/bg_notification_circle"
            android:clickable="true"
            android:contentDescription="@string/occurrence_back"
            android:elevation="2dp"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_left" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pick_title"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPickContext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:textColor="@color/volta_text_secondary_light"
            android:textSize="@dimen/text_size_body_small" />

        <ProgressBar
            android:id="@+id/loadingPick"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_large" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPickCooperatives"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/tvEmptyPick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/spacing_large"
            android:text="@string/empty_list"
            android:textColor="@color/volta_text_secondary_light"
            android:textSize="@dimen/text_size_body_small"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
