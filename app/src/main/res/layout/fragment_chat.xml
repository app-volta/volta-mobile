<?xml version="1.0" encoding="utf-8"?>
<!-- Chat com a cooperativa — Figma 790:3191 (Fase 11, mock local) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volta_background_light"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_normal">

        <FrameLayout
            android:id="@+id/btnBackChat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="@dimen/spacing_small"
            android:background="@drawable/bg_notification_circle"
            android:clickable="true"
            android:contentDescription="@string/occurrence_back"
            android:elevation="2dp"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_left" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_fab_gradient">

            <TextView
                android:id="@+id/tvChatAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_section"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="@dimen/text_size_section"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_step_done" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:text="@string/chat_online"
                    android:textColor="@color/volta_text_secondary_light"
                    android:textSize="@dimen/text_size_body_small" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/messagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_normal">

            <!-- Card de coleta agendada (mock) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:background="@drawable/bg_card_stat_resolved"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_medium">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_stat_icon_green">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_notif_truck"
                        app:tint="@color/stat_resolved_icon" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chat_pickup_title"
                        android:textColor="@color/volta_green_deep"
                        android:textSize="@dimen/text_size_body_small"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPickupSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/volta_text_secondary_light"
                        android:textSize="@dimen/text_size_caption" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Respostas rápidas -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/spacing_normal"
        android:paddingEnd="@dimen/spacing_normal"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipQuick1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_small"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/spacing_medium"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/spacing_medium"
                android:paddingBottom="8dp"
                android:text="@string/chat_quick_1"
                android:textColor="@color/volta_green_primary"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipQuick2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_small"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/spacing_medium"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/spacing_medium"
                android:paddingBottom="8dp"
                android:text="@string/chat_quick_2"
                android:textColor="@color/volta_green_primary"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipQuick3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/spacing_medium"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/spacing_medium"
                android:paddingBottom="8dp"
                android:text="@string/chat_quick_3"
                android:textColor="@color/volta_green_primary"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Entrada -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_normal">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_small"
            android:layout_weight="1"
            android:background="@drawable/bg_card_surface"
            android:hint="@string/chat_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="3"
            android:minHeight="@dimen/tap_target_min"
            android:paddingStart="@dimen/spacing_medium"
            android:paddingTop="@dimen/spacing_small"
            android:paddingEnd="@dimen/spacing_medium"
            android:paddingBottom="@dimen/spacing_small"
            android:textColor="@color/volta_text_primary_light"
            android:textColorHint="@color/volta_text_muted_light"
            android:textSize="@dimen/text_size_body" />

        <FrameLayout
            android:id="@+id/btnSend"
            android:layout_width="@dimen/tap_target_min"
            android:layout_height="@dimen/tap_target_min"
            android:background="@drawable/bg_fab_gradient"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_send" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
