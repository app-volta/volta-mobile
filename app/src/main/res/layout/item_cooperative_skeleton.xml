<?xml version="1.0" encoding="utf-8"?>
<!-- Skeleton de item de cooperativa (espelha item_cooperative_card.xml) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    android:background="@drawable/bg_card_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_medium">

    <View
        android:layout_width="@dimen/thumbnail_size_occurrence"
        android:layout_height="@dimen/thumbnail_size_occurrence"
        android:background="@drawable/bg_skeleton_bar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_weight="1"
        android:orientation="vertical">

        <View
            android:layout_width="140dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_skeleton_bar" />

        <View
            android:layout_width="90dp"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_skeleton_bar" />

        <View
            android:layout_width="110dp"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_skeleton_bar" />
    </LinearLayout>

    <View
        android:layout_width="48dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_skeleton_pill" />
</LinearLayout>
