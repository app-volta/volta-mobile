<?xml version="1.0" encoding="utf-8"?>
<!-- Código da nova senha — Figma 790:1154 (Fase 13b, mock + timer de reenvio) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volta_background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/spacing_normal">

        <FrameLayout
            android:id="@+id/btnBackPasscode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:background="@drawable/bg_notification_circle"
            android:clickable="true"
            android:contentDescription="@string/occurrence_back"
            android:elevation="2dp"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_left" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:background="@drawable/bg_occurrence_icon">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mail"
                app:tint="@color/occurrence_icon_tint" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_code_title"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="@dimen/text_size_headline"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPasscodeSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginBottom="@dimen/spacing_large"
            android:gravity="center"
            android:textColor="@color/volta_text_secondary_light"
            android:textSize="@dimen/text_size_body_small" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etPass1"
                android:layout_width="56dp"
                android:layout_height="64dp"
                android:layout_marginEnd="@dimen/spacing_small"
                android:background="@drawable/bg_card_surface"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPass2"
                android:layout_width="56dp"
                android:layout_height="64dp"
                android:layout_marginEnd="@dimen/spacing_small"
                android:background="@drawable/bg_card_surface"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPass3"
                android:layout_width="56dp"
                android:layout_height="64dp"
                android:layout_marginEnd="@dimen/spacing_small"
                android:background="@drawable/bg_card_surface"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPass4"
                android:layout_width="56dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_card_surface"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmPasscode"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_primary"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:backgroundTint="@color/volta_green_primary"
            android:text="@string/auth_confirm_btn"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_no_code"
            android:textColor="@color/volta_text_secondary_light"
            android:textSize="@dimen/text_size_body_small" />

        <TextView
            android:id="@+id/tvResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/spacing_small"
            android:textColor="@color/volta_green_primary"
            android:textSize="@dimen/text_size_body_small"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
