<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo para Adicionar Observação à Ocorrência (Figma 790:2725 / Fase 33) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_finalize"
    android:elevation="12dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_action_chip">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@string/occ_action_observe"
            android:src="@drawable/ic_stat_open"
            app:tint="@color/occurrence_icon_tint_purple" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="@string/occ_action_observe"
        android:textColor="@color/dialog_finalize_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="Registre anotações, condições de armazenagem ou observações de campo para o relatório PGRS."
        android:textColor="@color/dialog_finalize_sub"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etObservationInput"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_search_input"
        android:gravity="top|start"
        android:hint="Ex: Material molhado pela chuva, aguardando troca de caçamba..."
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="@color/volta_text_primary_light"
        android:textColorHint="@color/volta_text_muted_light"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveObservation"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="@color/volta_green_primary"
        android:text="Salvar observação"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />

    <TextView
        android:id="@+id/btnCancelObservation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:text="@string/pick_confirm_no"
        android:textColor="@color/dialog_finalize_sub"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
