<?xml version="1.0" encoding="utf-8"?>
<!-- Relatórios — Figma 790:3322: PGRS, período, mês, meta, por material -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volta_background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_normal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_reports"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:text="@string/reports_subtitle"
            android:textColor="@color/volta_text_secondary_light"
            android:textSize="@dimen/text_size_body_small" />

        <!-- Período -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipWeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_small"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/reports_period_week"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_small"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/reports_period_month"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipQuarter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/reports_period_quarter"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card PGRS -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:background="@drawable/bg_card_cta"
            android:padding="@dimen/spacing_normal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/iconPgrs"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reports_pgrs_title"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_section"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:text="@string/reports_pgrs_sub"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_body_small" />

                <TextView
                    android:id="@+id/btnGeneratePgrs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_button_cta_white"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="@dimen/spacing_normal"
                    android:paddingTop="10dp"
                    android:paddingEnd="@dimen/spacing_normal"
                    android:paddingBottom="10dp"
                    android:text="@string/reports_pgrs_button"
                    android:textColor="@color/volta_green_dark"
                    android:textSize="@dimen/text_size_body_small"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iconPgrs"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_nav_reports"
                app:tint="@color/white" />
        </RelativeLayout>

        <!-- Neste mês -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_small"
            android:text="@string/reports_month_title"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="@dimen/text_size_section"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/card_stat_height"
                android:layout_marginEnd="@dimen/spacing_small"
                android:layout_weight="1"
                android:background="@drawable/bg_card_stat_open"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_small">

                <TextView
                    android:id="@+id/tvReportOccurrences"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/stat_open_icon"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/reports_stat_occurrences"
                    android:textColor="@color/volta_text_secondary_light"
                    android:textSize="@dimen/text_size_caption" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/card_stat_height"
                android:layout_marginEnd="@dimen/spacing_small"
                android:layout_weight="1"
                android:background="@drawable/bg_card_stat_resolved"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_small">

                <TextView
                    android:id="@+id/tvReportKg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/stat_resolved_icon"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/reports_stat_kg"
                    android:textColor="@color/volta_text_secondary_light"
                    android:textSize="@dimen/text_size_caption" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/card_stat_height"
                android:layout_weight="1"
                android:background="@drawable/bg_card_stat_recycled"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_small">

                <TextView
                    android:id="@+id/tvReportRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/stat_recycled_icon"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/reports_stat_rate"
                    android:textColor="@color/volta_text_secondary_light"
                    android:textSize="@dimen/text_size_caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- Meta do mês -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="@dimen/spacing_normal">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_small">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/reports_goal_title"
                    android:textColor="@color/volta_text_primary_light"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGoalPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_badge_baixa"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/priority_low_text"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGoalCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/volta_text_primary_light"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGoalTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:textColor="@color/volta_text_secondary_light"
                    android:textSize="@dimen/text_size_body_small" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@drawable/bg_progress_track"
                android:orientation="horizontal">

                <View
                    android:id="@+id/viewGoalProgress"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_progress_filled" />
            </LinearLayout>
        </LinearLayout>

        <!-- Por tipo de material -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_small"
            android:text="@string/reports_by_material"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="@dimen/text_size_section"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/materialContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="@dimen/spacing_normal" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
