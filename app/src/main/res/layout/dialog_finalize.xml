<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo de confirmação para finalizar ocorrência — Figma 851:4885 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_finalize"
    android:elevation="12dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Ícone de Checkmark Verde Circular -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_occurrence_icon_green">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_notif_check"
            app:tint="@color/vf_green" />
    </FrameLayout>

    <!-- Título do Diálogo -->
    <TextView
        android:id="@+id/tvFinalizeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="Finalizar ocorrência?"
        android:textColor="@color/vf_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Texto Explicativo -->
    <TextView
        android:id="@+id/tvFinalizeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="O resíduo será marcado como pronto para destinação e incluído no relatório de conformidade do PGRS."
        android:textColor="@color/vf_text_secondary"
        android:textSize="13sp" />

    <!-- Box de Resumo da Ocorrência -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_confidence_row"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvDialogSummaryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="Papelão (Classe B) · ≈ 38 kg"
            android:textColor="@color/vf_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogSummarySector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Frigorífico — Setor B2"
            android:textColor="@color/vf_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Botão de Confirmação Principal -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFinalizeYes"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_btn_primary_v"
        android:fontFamily="sans-serif"
        android:text="Sim, finalizar ocorrência"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:cornerRadius="14dp" />

    <!-- Botão Cancelar -->
    <TextView
        android:id="@+id/btnFinalizeNo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:text="Cancelar e voltar"
        android:textColor="@color/vf_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
