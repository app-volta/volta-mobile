<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo Finalizar ocorrência (Figma 851:4885) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_finalize"
    android:elevation="12dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="32dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_dialog_check_circle">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="@string/toast_finalized_title"
            android:src="@drawable/ic_notif_check"
            app:tint="@color/status_aprovada_text" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:text="@string/occ_finalize_title"
        android:textColor="@color/dialog_finalize_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/occ_finalize_text"
        android:textColor="@color/dialog_finalize_sub"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFinalizeYes"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="@color/volta_green_primary"
        android:text="@string/occ_finalize_yes"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />

    <TextView
        android:id="@+id/btnFinalizeNo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:text="@string/pick_confirm_no"
        android:textColor="@color/dialog_finalize_sub"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
