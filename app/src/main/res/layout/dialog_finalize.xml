<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo de confirmação para finalizar ocorrência — Figma 851:4885 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_finalize"
    android:elevation="12dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="32dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Ícone de Checkmark Verde Circular em squircle verde claro -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_circle_green_light">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_check_circle_green" />
    </FrameLayout>

    <!-- Título do Diálogo -->
    <TextView
        android:id="@+id/tvFinalizeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="@string/occ_finalize_title"
        android:textColor="@color/vf_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Texto Explicativo -->
    <TextView
        android:id="@+id/tvFinalizeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/occ_finalize_text"
        android:textColor="@color/vf_text_secondary"
        android:textSize="14sp" />

    <!-- Resumo opcional mantido com visibility gone para compatibilidade de código -->
    <LinearLayout
        android:id="@+id/boxDialogSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDialogSummaryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvDialogSummarySector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Botão de Confirmação Principal -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFinalizeYes"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_btn_primary_v"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/occ_finalize_yes"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:cornerRadius="16dp" />

    <!-- Botão Voltar -->
    <TextView
        android:id="@+id/btnFinalizeNo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:text="Voltar"
        android:textColor="@color/vf_text_secondary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
