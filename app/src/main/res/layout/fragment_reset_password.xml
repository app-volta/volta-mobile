<?xml version="1.0" encoding="utf-8"?>
<!-- Criar nova senha — Figma 790:1190 (Fase 13b, mock + medidor de força) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volta_background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_normal">

        <FrameLayout
            android:id="@+id/btnBackReset"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:background="@drawable/bg_notification_circle"
            android:clickable="true"
            android:contentDescription="@string/occurrence_back"
            android:elevation="2dp"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_left" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:background="@drawable/bg_occurrence_icon_green">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock"
                app:tint="@color/stat_resolved_icon" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_reset_title"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="@dimen/text_size_headline"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginBottom="@dimen/spacing_large"
            android:text="@string/auth_reset_sub"
            android:textColor="@color/volta_text_secondary_light"
            android:textSize="@dimen/text_size_body_small" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xs"
            android:text="@string/auth_new_password"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_small"
            android:background="@drawable/bg_card_surface">

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="••••••••"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:minHeight="@dimen/button_height_primary"
                android:paddingStart="@dimen/spacing_normal"
                android:paddingEnd="52dp"
                android:drawableStart="@drawable/ic_lock"
                android:drawableTint="@color/volta_text_muted_light"
                android:drawablePadding="@dimen/spacing_small"
                android:textColor="@color/volta_text_primary_light"
                android:textColorHint="@color/volta_text_muted_light"
                android:textSize="@dimen/text_size_body" />

            <ImageView
                android:id="@+id/btnToggleNewPassword"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_eye"
                app:tint="@color/volta_text_muted_light" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:weightSum="4">

                <View
                    android:id="@+id/strength1"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_progress_track" />

                <View
                    android:id="@+id/strength2"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_progress_track" />

                <View
                    android:id="@+id/strength3"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_progress_track" />

                <View
                    android:id="@+id/strength4"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_progress_track" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStrength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/status_aprovada_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xs"
            android:text="@string/auth_confirm_password"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:background="@drawable/bg_card_surface">

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="••••••••"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:minHeight="@dimen/button_height_primary"
                android:paddingStart="@dimen/spacing_normal"
                android:paddingEnd="@dimen/spacing_normal"
                android:drawableStart="@drawable/ic_lock"
                android:drawableTint="@color/volta_text_muted_light"
                android:drawablePadding="@dimen/spacing_small"
                android:textColor="@color/volta_text_primary_light"
                android:textColorHint="@color/volta_text_muted_light"
                android:textSize="@dimen/text_size_body" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/volta_green_primary"
            android:text="@string/auth_save_password"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
