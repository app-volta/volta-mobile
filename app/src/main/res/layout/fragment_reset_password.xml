<?xml version="1.0" encoding="utf-8"?>
<!-- Criar nova senha — Figma 790:1190 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volta_background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- Botão Voltar (40x40dp, r20) -->
        <FrameLayout
            android:id="@+id/btnBackReset"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_notification_circle"
            android:clickable="true"
            android:contentDescription="@string/occurrence_back"
            android:elevation="2dp"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/volta_text_primary_light" />
        </FrameLayout>

        <!-- Badge Circular Padronizado 84x84dp (#E2F7EC com ic_lock verde) -->
        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_circle_badge_pastel"
            android:backgroundTint="@color/vf_green_bg">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:contentDescription="@string/auth_reset_title"
                android:src="@drawable/ic_lock"
                app:tint="@color/status_aprovada_text" />
        </FrameLayout>

        <!-- Título e Subtítulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_poppins"
            android:text="@string/auth_reset_title"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/font_inter"
            android:lineSpacingExtra="2dp"
            android:text="@string/auth_reset_sub"
            android:textColor="@color/volta_text_secondary_light"
            android:textSize="14sp" />

        <!-- Label Nova Senha -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/font_poppins"
            android:text="@string/auth_new_password"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Card Nova Senha (56dp, r16) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_surface_default"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_r9"
                android:backgroundTint="@color/vf_green_bg">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/status_aprovada_text" />
            </FrameLayout>

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/font_inter"
                android:hint="••••••••"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:textColor="@color/volta_text_primary_light"
                android:textColorHint="@color/volta_text_muted_light"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btnToggleNewPassword"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true"
                android:src="@drawable/ic_eye"
                app:tint="@color/vf_text_secondary" />
        </LinearLayout>

        <!-- Medidor de Força: 4 barras de 79x5dp r3 (total 334dp) com nível abaixo alinhado à esquerda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:id="@+id/strength1"
                    android:layout_width="79dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_strength_bar_track" />

                <View
                    android:id="@+id/strength2"
                    android:layout_width="79dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_strength_bar_track" />

                <View
                    android:id="@+id/strength3"
                    android:layout_width="79dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_strength_bar_track" />

                <View
                    android:id="@+id/strength4"
                    android:layout_width="79dp"
                    android:layout_height="5dp"
                    android:background="@drawable/bg_strength_bar_track" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStrength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/font_inter"
                android:gravity="start"
                android:textColor="@color/priority_high_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Label Confirmar Nova Senha -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/font_poppins"
            android:text="@string/auth_confirm_password"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Card Confirmar Senha: borda verde ativa, chip verde e check circular quando matching -->
        <LinearLayout
            android:id="@+id/cardConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_card_surface_default"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <FrameLayout
                android:id="@+id/chipConfirmPassword"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_r9"
                android:backgroundTint="@color/confidence_row_bg">

                <ImageView
                    android:id="@+id/ivConfirmLock"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/volta_text_muted_light" />
            </FrameLayout>

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/font_inter"
                android:hint="••••••••"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:textColor="@color/volta_text_primary_light"
                android:textColorHint="@color/volta_text_muted_light"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/ivConfirmMatch"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_circle_green"
                android:visibility="gone" />
        </LinearLayout>

        <!-- CTA Salvar Nova Senha (Gradiente Verde) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSavePassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_button_gradient"
            android:fontFamily="@font/font_poppins"
            android:stateListAnimator="@null"
            android:text="@string/auth_save_password"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
