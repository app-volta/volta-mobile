<?xml version="1.0" encoding="utf-8"?>
<!-- Card de notificação — Figma 790:1864 (não lida #F7F8FC) e 790:1895 (lida #FFFFFF c/ borda #EEF0F5) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_notif_card_read"
    android:gravity="top"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:id="@+id/notifIconContainer"
        android:layout_width="@dimen/thumbnail_size_occurrence"
        android:layout_height="@dimen/thumbnail_size_occurrence"
        android:background="@drawable/bg_occurrence_icon">

        <ImageView
            android:id="@+id/notifIcon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_notif_bell" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notifTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_poppins"
            android:includeFontPadding="false"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notifDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/font_inter"
            android:textColor="@color/volta_text_secondary_light"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/notifTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/font_inter"
            android:textColor="#6B7686"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/notifBadge"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:background="@drawable/bg_badge_nova"
        android:fontFamily="@font/font_inter"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/notifications_badge_new"
        android:textColor="@color/white"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
