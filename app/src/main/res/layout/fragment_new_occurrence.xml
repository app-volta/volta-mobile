<?xml version="1.0" encoding="utf-8"?>
<!-- Fluxo de Registro — Figma 851:3792 (12 · Registrar, 13 · Registrar · câmera, 14 · Registrar · foto anexada) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vf_bg">

    <!-- Fundo de fluidos decorativo da marca -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:alpha="0.35"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_fluidos" />

    <!-- Conteúdo principal do formulário (12 e 14) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Botão Voltar -->
            <FrameLayout
                android:id="@+id/btnBackRegister"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_notification_circle"
                android:clickable="true"
                android:contentDescription="@string/occurrence_back"
                android:elevation="2dp"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chevron_left" />
            </FrameLayout>

            <!-- Título e Subtítulo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/occurrence_new_title"
                android:textColor="@color/vf_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp"
                android:fontFamily="sans-serif"
                android:text="@string/occurrence_step_1"
                android:textColor="@color/vf_text_secondary"
                android:textSize="12sp" />

            <!-- Progresso 1 de 2: duas barras arredondadas discretas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_step_filled" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_step_track" />
            </LinearLayout>

            <!-- Card da Foto: Vazio (12) ou Anexado (14) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <!-- Estado Vazio: Borda tracejada verde (Figma 851:3799) -->
                <LinearLayout
                    android:id="@+id/photoEmptyGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_photo_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="26dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_occurrence_icon_green">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_camera_official"
                            app:tint="@color/vf_green" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/occurrence_take_photo"
                        android:textColor="@color/vf_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="16dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/occurrence_photo_hint"
                        android:textColor="@color/vf_text_secondary"
                        android:textSize="12sp" />

                    <!-- Botões Câmera e Galeria -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCaptureCamera"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_camera_pill"
                            android:text="@string/occurrence_btn_camera"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null"
                            app:cornerRadius="22dp"
                            app:icon="@drawable/ic_camera_official"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="18dp"
                            app:iconTint="@color/white" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenGallery"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_gallery_pill"
                            android:text="@string/occurrence_btn_gallery"
                            android:textAllCaps="false"
                            android:textColor="@color/vf_green"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null"
                            app:cornerRadius="22dp"
                            app:icon="@drawable/ic_gallery_green"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="18dp"
                            app:iconTint="@color/vf_green" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Estado Foto Anexada (Figma 851:3904) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/photoPreviewGroup"
                    android:layout_width="match_parent"
                    android:layout_height="224dp"
                    android:visibility="gone"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/vf_border"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/imgPhotoPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_caixas_papelao" />

                        <!-- Badge superior esquerdo: "Foto anexada" -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_pill_white_14"
                            android:elevation="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_check_circle_green" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:fontFamily="sans-serif"
                                android:text="Foto anexada"
                                android:textColor="@color/vf_green_deep"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Botão inferior direito: "Trocar" -->
                        <LinearLayout
                            android:id="@+id/btnRetakePhoto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_pill_dark_trocar"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp">

                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:src="@drawable/ic_refresh_white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:fontFamily="sans-serif"
                                android:text="@string/occurrence_retake"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <!-- Campo Descrição (opcional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/occurrence_desc_label"
                android:textColor="@color/vf_text_body"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_register"
                android:fontFamily="sans-serif"
                android:gravity="top"
                android:hint="@string/occurrence_desc_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:padding="14dp"
                android:textColor="@color/vf_text_primary"
                android:textColorHint="@color/vf_hint"
                android:textSize="13sp" />

            <!-- Campo Localização -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/occurrence_location_label"
                android:textColor="@color/vf_text_body"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnSector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="28dp"
                android:background="@drawable/bg_input_register"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip_pin">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_pin"
                        app:tint="@color/vf_green" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvSector"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Tag Alterar cinza sutil -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_r9"
                    android:fontFamily="sans-serif"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="Alterar"
                    android:textColor="@color/vf_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Botão Enviar para análise -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendAnalysis"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn_disabled_v"
                android:enabled="false"
                android:fontFamily="sans-serif"
                android:text="@string/occurrence_btn_send_analysis"
                android:textAllCaps="false"
                android:textColor="@color/vf_disabled_text"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Overlay Câmera / Viewfinder (Figma 851:3852 — 13 · Registrar · câmera) -->
    <FrameLayout
        android:id="@+id/cameraViewfinderOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#050806"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- Barra Superior da Câmera -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Fechar Câmera -->
            <FrameLayout
                android:id="@+id/btnCameraClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_camera_circle_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_close_white" />
            </FrameLayout>

            <!-- Pill Central: "Enquadre o resíduo" -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_pill_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_sparkle"
                    app:tint="@color/vf_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif"
                    android:text="Enquadre o resíduo"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Flash -->
            <FrameLayout
                android:id="@+id/btnCameraFlash"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_camera_circle_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_flash_white" />
            </FrameLayout>
        </RelativeLayout>

        <!-- Viewfinder Central com Foto e Miras nos cantos -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:layout_marginTop="88dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="140dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#30FFFFFF"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/cameraPreviewImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_caixas_papelao" />

                    <!-- Corner Brackets (Miras) -->
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="16dp"
                        android:src="@drawable/ic_camera_mira" />

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="16dp"
                        android:rotation="90"
                        android:src="@drawable/ic_camera_mira" />

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="16dp"
                        android:rotation="270"
                        android:src="@drawable/ic_camera_mira" />

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="16dp"
                        android:rotation="180"
                        android:src="@drawable/ic_camera_mira" />

                    <!-- Dica inferior no visor -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="18dp"
                        android:background="@drawable/bg_pill_dark"
                        android:fontFamily="sans-serif"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        android:text="IA detectará volume e classe"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Barra Inferior de Disparo da Câmera -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="bottom"
            android:paddingStart="36dp"
            android:paddingEnd="36dp">

            <!-- Botão Galeria / Miniatura -->
            <FrameLayout
                android:id="@+id/btnCameraPickGallery"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_camera_square_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_gallery_green"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- Botão Disparador (Shutter) -->
            <FrameLayout
                android:id="@+id/btnCameraShutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_camera_shutter_outer"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_camera_shutter_inner" />
            </FrameLayout>

            <!-- Botão Inverter Câmera -->
            <FrameLayout
                android:id="@+id/btnCameraFlip"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_camera_circle_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_refresh_white" />
            </FrameLayout>
        </RelativeLayout>
    </FrameLayout>
</FrameLayout>
