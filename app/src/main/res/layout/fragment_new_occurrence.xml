<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volta_background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_normal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/occurrence_new_title"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="@dimen/text_size_headline"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/occurrence_step_1"
            android:textColor="@color/volta_text_secondary_light"
            android:textSize="@dimen/text_size_body_small" />

        <!-- Card de Captura de Foto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            android:background="@drawable/bg_card_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_avatar"
                android:backgroundTint="@color/volta_green_subtle"
                android:padding="@dimen/spacing_small"
                android:src="@drawable/ic_nav_add"
                app:tint="@color/volta_green_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/occurrence_take_photo"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="@dimen/text_size_subtitle"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/occurrence_photo_hint"
                android:textAlignment="center"
                android:textColor="@color/volta_text_secondary_light"
                android:textSize="@dimen/text_size_body_small" />

            <!-- Botões Câmera e Galeria -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCaptureCamera"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/tap_target_min"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:backgroundTint="@color/volta_green_primary"
                    android:text="@string/occurrence_btn_camera"
                    android:textColor="@color/white"
                    app:cornerRadius="@dimen/corner_radius_button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenGallery"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/tap_target_min"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:text="@string/occurrence_btn_gallery"
                    android:textColor="@color/volta_green_dark"
                    app:cornerRadius="@dimen/corner_radius_button"
                    app:strokeColor="@color/volta_green_primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Botão Enviar para Análise -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendAnalysis"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_primary"
            android:layout_marginTop="@dimen/spacing_large"
            android:backgroundTint="@color/volta_green_primary"
            android:text="@string/occurrence_btn_send_analysis"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            app:cornerRadius="@dimen/corner_radius_button" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
