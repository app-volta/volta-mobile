<?xml version="1.0" encoding="utf-8"?>
<!-- Card de cooperativa — Figma Cooperativas (626:582). Primeiro item em destaque verde. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    android:background="@drawable/bg_card_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_medium">

    <FrameLayout
        android:id="@+id/coopIconContainer"
        android:layout_width="@dimen/thumbnail_size_occurrence"
        android:layout_height="@dimen/thumbnail_size_occurrence"
        android:background="@drawable/bg_occurrence_icon">

        <ImageView
            android:id="@+id/coopIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_volta_arrow_white"
            app:tint="@color/occurrence_icon_tint" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/coopName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/volta_text_primary_light"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/coopTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:background="@drawable/bg_badge_cta_green"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/coopDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/volta_text_secondary_light"
            android:textSize="@dimen/text_size_caption" />

        <TextView
            android:id="@+id/coopDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_body_small"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/coopRatingContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_notif_star" />

        <TextView
            android:id="@+id/coopRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/volta_text_primary_light"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
