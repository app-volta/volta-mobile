<?xml version="1.0" encoding="utf-8"?>
<!-- 23a · Perfil · editar dados (Figma 1721:1264) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volta_background_light">

    <!-- Fundo oficial com fluidos e formas -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_fluidos" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="40dp">

            <!-- Botão Voltar (40x40dp circular branco com sombra) -->
            <FrameLayout
                android:id="@+id/btnBackEditProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_circle_white_shadow"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/btn_back"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="#1B2430" />
            </FrameLayout>

            <!-- Título e Subtítulo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Editar perfil"
                android:textColor="#1B2430"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/font_inter"
                android:lineSpacingExtra="3dp"
                android:text="Esses dados aparecem pra sua equipe e no painel do gestor."
                android:textColor="#7C8698"
                android:textSize="14sp" />

            <!-- Bloco Avatar + Trocar foto -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/avatarContainerEdit"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:background="@drawable/bg_circle_avatar_white"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/imgEditProfilePhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Foto de perfil"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvEditProfileInitials"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="#0E7C48"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="BG" />
                </FrameLayout>

                <TextView
                    android:id="@+id/btnChangePhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/font_inter"
                    android:padding="8dp"
                    android:text="Trocar foto"
                    android:textColor="#1BA463"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Campo 1: Nome completo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/font_inter"
                android:text="Nome completo"
                android:textColor="#1B2430"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card_surface_16"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip_r9"
                    android:backgroundTint="#FFEFE2">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_nav_profile"
                        app:tint="#E8893A" />
                </FrameLayout>

                <EditText
                    android:id="@+id/etEditProfileName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:fontFamily="@font/font_inter"
                    android:hint="Seu nome e sobrenome"
                    android:inputType="textPersonName"
                    android:textColor="#1B2430"
                    android:textColorHint="#9AA3B2"
                    android:textSize="15sp"
                    tools:text="Breno Gomes" />
            </LinearLayout>

            <!-- Campo 2: E-mail da unidade -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/font_inter"
                android:text="E-mail da unidade"
                android:textColor="#1B2430"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_card_surface_16"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip_r9"
                    android:backgroundTint="#E4EFFF">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mail"
                        app:tint="#3B82F6" />
                </FrameLayout>

                <EditText
                    android:id="@+id/etEditProfileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:enabled="false"
                    android:focusable="false"
                    android:fontFamily="@font/font_inter"
                    android:textColor="#7C8698"
                    android:textSize="15sp"
                    tools:text="breno@volta.com" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/font_inter"
                android:text="Quem muda o e-mail é o gestor da unidade."
                android:textColor="#7C8698"
                android:textSize="12sp" />

            <!-- Campo 3: Setor -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/font_inter"
                android:text="Setor"
                android:textColor="#1B2430"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnSelectSector"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card_surface_16"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip_r9"
                    android:backgroundTint="#EFEAFB">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_factory"
                        app:tint="#8B6FE0" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvEditProfileSector"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/font_inter"
                    android:textColor="#1B2430"
                    android:textSize="15sp"
                    tools:text="Frigorífico — Setor B2" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="#1B2430" />
            </LinearLayout>

            <!-- Linha Alterar Senha (Card 50dp) -->
            <LinearLayout
                android:id="@+id/rowChangePassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_card_surface_16"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    app:tint="#374151" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/font_inter"
                    android:text="Alterar senha"
                    android:textColor="#1B2430"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#9CA3AF" />
            </LinearLayout>

            <!-- Botão Salvar alterações -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveProfileChanges"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_button_gradient"
                android:fontFamily="@font/font_inter"
                android:text="Salvar alterações"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
