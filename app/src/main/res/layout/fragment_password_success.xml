<?xml version="1.0" encoding="utf-8"?>
<!-- Senha atualizada com sucesso — Figma 790:1241 (Fase 22) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_green"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/spacing_large">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xlarge"
        android:layout_marginBottom="32dp"
        android:text="VOLTA"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Mascote VOLTA com selo circular de check sobreposto (Figma 790:1241) -->
    <FrameLayout
        android:layout_width="160dp"
        android:layout_height="180dp"
        android:layout_marginBottom="24dp">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/mascote_volta" />

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_badge_check_white"
            android:elevation="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/auth_passok_title"
                android:src="@drawable/ic_notif_check"
                app:tint="@color/status_aprovada_text" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auth_passok_title"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/auth_passok_sub"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoLogin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="@color/white"
        android:text="@string/auth_go_login"
        android:textColor="@color/status_aprovada_text"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="16dp" />
</LinearLayout>
