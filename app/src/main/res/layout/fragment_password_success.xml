<?xml version="1.0" encoding="utf-8"?>
<!-- Senha atualizada — Figma 790:1241 (Fase 13b) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_green"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_large">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xlarge"
        android:text="VOLTA"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:background="@drawable/bg_button_cta_white">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_notif_check"
            app:tint="@color/volta_green_dark" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auth_passok_title"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:layout_marginBottom="@dimen/spacing_large"
        android:gravity="center"
        android:text="@string/auth_passok_sub"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_body_small" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoLogin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_primary"
        android:background="@drawable/bg_button_cta_white"
        android:text="@string/auth_go_login"
        android:textColor="@color/volta_green_dark"
        android:textSize="@dimen/text_size_body"
        android:textStyle="bold" />
</LinearLayout>
