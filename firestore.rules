rules_version = '2';

// =============================================================================
// VOLTA — Cloud Firestore Security Rules
// =============================================================================
// Security architecture designed for the VOLTA Waste Management & Circular Economy
// mobile application and web management dashboard (Android / Firebase Firestore).
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Assumed Data Model
    // =========================================================================
    //
    // Collection: notifications
    // Document ID: auto-generated or string ID (e.g., n1, n2, or Firestore UUID)
    // Fields:
    //   - id: string (optional, 1..128 chars) - Client or local notification identifier
    //   - tipo: string (required, enum) - Notification category:
    //       ['NOVA_OCORRENCIA', 'COLETA_AGENDADA', 'APROVACAO', 'META', 'RANKING', 'SYNC', 'ALERTA', 'INFO', 'SISTEMA']
    //   - titulo: string (required, 1..200 chars) - Title displayed in UI and system status bar
    //   - descricao: string (optional, 0..1000 chars) - Detail text / body
    //   - icone: string (optional, 1..50 chars) - Icon name (e.g. 'bell', 'check', 'truck', 'trophy', 'star')
    //   - tint: string (optional, 1..50 chars) - Hex color for tint (e.g. '#12A05E')
    //   - bg: string (optional, 1..50 chars) - Hex color for container background (e.g. '#E2F7EC')
    //   - lida: bool (required) - Read status indicator
    //   - timestamp: timestamp (required) - Creation / server timestamp
    //   - occurrence_id: string (optional/nullable, 0..100 chars) - Associated occurrence ID
    //   - user_id: string (required, 1..128 chars) - Target recipient ('all' for broadcast or user UID)
    //   - tempo_relativo: string (optional, 0..100 chars) - Formatted time label (e.g. 'há 5 min')
    //
    // Collection: users
    // Document ID: user email (e.g., breno@volta.com or sanitized) or auth UID
    // Fields:
    //   - name: string (optional, 1..200 chars) - User display name
    //   - email: string (optional, 3..128 chars) - User email address
    //   - photoUrl: string (optional/nullable, 0..500 chars) - Remote profile photo URL (e.g., Cloudinary)
    //   - avatarUrl: string (optional/nullable, 0..500 chars) - Mirrored avatar URL
    //   - position: string (optional, 0..100 chars) - Sector / operational position
    //   - updatedAt: timestamp (optional) - Profile modification timestamp
    //
    // Collection: incidents
    // Document ID: incident/occurrence identifier (e.g., inc_123 or UUID)
    // Fields:
    //   - id: string (optional, 1..128 chars) - Unique incident ID
    //   - photoUrl: string (optional/nullable, 0..500 chars) - Remote photo of the waste occurrence
    //   - setor: string (optional, 0..100 chars) - Operational facility sector
    //   - material: string (optional, 0..100 chars) - Waste material classification
    //   - quantidade: number (optional, >= 0) - Estimated weight / volume
    //   - status: string (optional, 1..50 chars) - Status lifecycle (e.g. 'EM_ANALISE', 'AGUARDANDO_VALIDACAO', 'APPROVED', 'APROVADO', 'APROVADA', 'FINALIZADA', 'RESOLVIDO')
    //   - prioridade: string (optional, 1..50 chars) - Operational priority (e.g. 'BAIXA', 'MEDIA', 'ALTA', 'MEDIUM', 'HIGH')
    //   - timestamp: timestamp (optional) - Incident registration timestamp
    //   - updatedAt: timestamp (optional) - Real-time sync / review timestamp
    //
    // =========================================================================

    // =========================================================================
    // Environment & Feature Flags
    // =========================================================================

    /**
     * Development Mode Flag:
     * Set to true to allow development/test operations while authentication screens
     * and Firebase Auth tokens are being provisioned in earlier phases.
     * Set to false for strict production enforcement requiring request.auth != null.
     */
    function isDevelopmentTestMode() {
      return true;
    }

    // =========================================================================
    // Helper Functions
    // =========================================================================

    /**
     * Check if request has an authenticated Firebase user.
     */
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Check if user is an administrator via custom token claims or verified admin email.
     */
    function isAdmin() {
      return isAuthenticated() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'admin') ||
        (request.auth.token.email != null && request.auth.token.email.matches(".*@admin\\.volta\\.com$"))
      );
    }

    /**
     * Check if user is owner of the given user ID (by UID or email).
     */
    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (request.auth.token.email != null && request.auth.token.email == userId)
      );
    }

    /**
     * Verify list of allowed notification types.
     */
    function isAllowedNotificationType(tipo) {
      return tipo in [
        'NOVA_OCORRENCIA',
        'COLETA_AGENDADA',
        'APROVACAO',
        'META',
        'RANKING',
        'SYNC',
        'ALERTA',
        'INFO',
        'SISTEMA'
      ];
    }

    // =========================================================================
    // Domain Validators (Validator Function Pattern)
    // =========================================================================

    /**
     * Strict Domain Validator for Notification documents.
     * Enforced on BOTH create and update operations to prevent the Update Bypass vulnerability.
     */
    function isValidNotification(data) {
      let allowedFields = [
        'id', 'tipo', 'titulo', 'descricao', 'icone', 'tint', 'bg',
        'lida', 'timestamp', 'occurrence_id', 'user_id', 'tempo_relativo'
      ];
      let requiredFields = [
        'tipo', 'titulo', 'lida', 'timestamp', 'user_id'
      ];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.tipo is string && isAllowedNotificationType(data.tipo) &&
             data.titulo is string && data.titulo.size() >= 1 && data.titulo.size() <= 200 &&
             (!('descricao' in data) || (data.descricao is string && data.descricao.size() <= 1000)) &&
             (!('icone' in data) || (data.icone is string && data.icone.size() >= 1 && data.icone.size() <= 50)) &&
             (!('tint' in data) || (data.tint is string && data.tint.size() >= 1 && data.tint.size() <= 50)) &&
             (!('bg' in data) || (data.bg is string && data.bg.size() >= 1 && data.bg.size() <= 50)) &&
             data.lida is bool &&
             data.timestamp is timestamp &&
             (!('occurrence_id' in data) || data.occurrence_id == null || (data.occurrence_id is string && data.occurrence_id.size() <= 100)) &&
             data.user_id is string && data.user_id.size() >= 1 && data.user_id.size() <= 128 &&
             (!('id' in data) || (data.id is string && data.id.size() >= 1 && data.id.size() <= 128)) &&
             (!('tempo_relativo' in data) || (data.tempo_relativo is string && data.tempo_relativo.size() <= 100));
    }

    /**
     * Strict Domain Validator for User profile documents.
     * Enforced on BOTH create and update operations to prevent the Update Bypass vulnerability.
     */
    function isValidUser(data) {
      let allowedFields = [
        'name', 'email', 'photoUrl', 'avatarUrl', 'position', 'updatedAt'
      ];

      return data.keys().size() > 0 &&
             data.keys().hasOnly(allowedFields) &&
             (!('name' in data) || (data.name is string && data.name.size() >= 1 && data.name.size() <= 200)) &&
             (!('email' in data) || (data.email is string && data.email.size() >= 3 && data.email.size() <= 128)) &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             (!('position' in data) || (data.position is string && data.position.size() <= 100)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    /**
     * Strict Domain Validator for Incident documents.
     * Enforced on BOTH create and update operations to prevent the Update Bypass vulnerability.
     */
    function isValidIncident(data) {
      let allowedFields = [
        'id', 'photoUrl', 'setor', 'material', 'quantidade',
        'status', 'prioridade', 'timestamp', 'updatedAt'
      ];

      return data.keys().size() > 0 &&
             data.keys().hasOnly(allowedFields) &&
             (!('id' in data) || (data.id is string && data.id.size() >= 1 && data.id.size() <= 128)) &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('setor' in data) || (data.setor is string && data.setor.size() <= 100)) &&
             (!('material' in data) || (data.material is string && data.material.size() <= 100)) &&
             (!('quantidade' in data) || (data.quantidade is number && data.quantidade >= 0)) &&
             (!('status' in data) || (data.status is string && data.status.size() >= 1 && data.status.size() <= 50)) &&
             (!('prioridade' in data) || (data.prioridade is string && data.prioridade.size() >= 1 && data.prioridade.size() <= 50)) &&
             (!('timestamp' in data) || data.timestamp is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // =========================================================================
    // Rules: notifications Collection
    // =========================================================================

    match /notifications/{notificationId} {

      /**
       * READ:
       * Allows authenticated users (or public read during development test mode)
       * to retrieve real-time notification streams.
       * Accommodates the client query:
       * db.collection("notifications").orderBy("timestamp", Query.Direction.DESCENDING).limit(50)
       */
      allow read: if isAuthenticated() || isDevelopmentTestMode();

      /**
       * CREATE:
       * Allowed for authenticated users or system services (or during development test mode).
       * Must strictly satisfy schema type bounds and size limits.
       * Non-admin users cannot target arbitrary other users' private queues.
       */
      allow create: if (isAuthenticated() || isDevelopmentTestMode())
                    && isValidNotification(request.resource.data)
                    && (isDevelopmentTestMode() || isAdmin() || request.resource.data.user_id in ['all', request.auth.uid]);

      /**
       * UPDATE:
       * Restricted strictly to marking notifications as read ('lida' field).
       * - MUST satisfy isValidNotification (Validator Function Pattern)
       * - ONLY 'lida' may be altered; all other metadata (title, text, type, timestamp) is immutable
       * - Only the targeted recipient ('all' or matching user UID), admin, or dev mode can update
       */
      allow update: if (isAuthenticated() || isDevelopmentTestMode())
                    && isValidNotification(request.resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida'])
                    && (isDevelopmentTestMode() || resource.data.user_id == 'all' || resource.data.user_id == request.auth.uid || isAdmin());

      /**
       * DELETE:
       * Restricted strictly to administrators or document owners.
       */
      allow delete: if (isAuthenticated() && (resource.data.user_id == request.auth.uid || isAdmin()))
                    || (isDevelopmentTestMode() && isAdmin());
    }

    // =========================================================================
    // Rules: users Collection
    // =========================================================================

    match /users/{userId} {

      /**
       * READ:
       * Allows authenticated users (or anyone during development test mode) to read user profiles.
       */
      allow read: if isAuthenticated() || isDevelopmentTestMode();

      /**
       * CREATE:
       * Allowed if authenticated or during development test mode.
       * In production mode, users can only create their own profile document (or admin).
       * Must strictly satisfy schema type bounds and size limits.
       */
      allow create: if (isAuthenticated() || isDevelopmentTestMode())
                    && isValidUser(request.resource.data)
                    && (isDevelopmentTestMode() || isAdmin() || isOwner(userId));

      /**
       * UPDATE:
       * Allowed if authenticated or during development test mode.
       * In production mode, users can only update their own profile document (or admin).
       * Must satisfy isValidUser (Validator Function Pattern) on post-write state.
       */
      allow update: if (isAuthenticated() || isDevelopmentTestMode())
                    && isValidUser(request.resource.data)
                    && (isDevelopmentTestMode() || isAdmin() || isOwner(userId));

      /**
       * DELETE:
       * Restricted strictly to administrators or document owners.
       */
      allow delete: if (isAuthenticated() && (isOwner(userId) || isAdmin()))
                    || (isDevelopmentTestMode() && isAdmin());
    }

    // =========================================================================
    // Rules: incidents Collection
    // =========================================================================

    match /incidents/{incidentId} {

      /**
       * READ:
       * Allows authenticated users (or anyone during development test mode) to read incidents
       * for real-time synchronization between mobile app and web dashboard.
       */
      allow read: if isAuthenticated() || isDevelopmentTestMode();

      /**
       * CREATE:
       * Allows authenticated users or development test mode to register an incident.
       * Must strictly satisfy schema type bounds and size limits.
       */
      allow create: if (isAuthenticated() || isDevelopmentTestMode())
                    && isValidIncident(request.resource.data);

      /**
       * UPDATE:
       * Allows authenticated users or development test mode to update incident status or details.
       * Must strictly satisfy schema type bounds and size limits via isValidIncident.
       */
      allow update: if (isAuthenticated() || isDevelopmentTestMode())
                    && isValidIncident(request.resource.data);

      /**
       * DELETE:
       * Restricted strictly to administrators.
       */
      allow delete: if (isAuthenticated() && isAdmin())
                    || (isDevelopmentTestMode() && isAdmin());
    }

    // =========================================================================
    // Default Deny
    // =========================================================================
    // Strictly deny read and write access to all other paths in the database.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
